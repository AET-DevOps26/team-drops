# LLM Provider.
# The default local QA path uses an OpenAI-compatible external API.
LLM_PROVIDER=openai

# OpenAI-compatible API key. Never commit a real value.
LLM_API_KEY=

# OpenAI-compatible model name.
LLM_MODEL=gpt-4o-mini

# Optional OpenAI-compatible base URL. Leave empty for OpenAI's default API.
LLM_BASE_URL=

# Ollama fallback — only used when LLM_PROVIDER=ollama.
# To use the opt-in Compose Ollama service, run with:
# docker compose --profile local-ollama up --build
# and set OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b

# Auth / Keycloak
AUTH_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=team-drops
KEYCLOAK_CLIENT_ID=team-drops
