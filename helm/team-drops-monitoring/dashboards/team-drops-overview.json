{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 1}, {"color": "green", "value": 4}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(up{job=\"team-drops-services\"})", "refId": "A"}],
      "title": "Healthy API Targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (service) (rate({__name__=~\"http_server_requests_seconds_count|http_requests_total\", namespace=\"team-drops\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "id": 3,
      "targets": [{"expr": "100 * sum by (service) (rate({__name__=~\"http_server_requests_seconds_count|http_requests_total\", namespace=\"team-drops\", status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate({__name__=~\"http_server_requests_seconds_count|http_requests_total\", namespace=\"team-drops\"}[5m])), 0.001)", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "HTTP 5xx Error Percentage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (service) (rate({__name__=~\"http_server_requests_seconds_sum|http_request_duration_seconds_sum\", namespace=\"team-drops\"}[5m])) / clamp_min(sum by (service) (rate({__name__=~\"http_server_requests_seconds_count|http_request_duration_seconds_count\", namespace=\"team-drops\"}[5m])), 0.001)", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Average Response Time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {"showHeader": true},
      "targets": [{"expr": "application_info{namespace=\"team-drops\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "Deployed Application Versions",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "instance": true, "job": true, "namespace": true}, "indexByName": {}, "renameByName": {"service": "Service", "version": "Version"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 3, "w": 6, "x": 0, "y": 5},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\", alertname=~\"TeamDrops.+\"}) or vector(0)", "refId": "A"}],
      "title": "Firing Runtime Alerts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 16},
      "id": 7,
      "targets": [{"expr": "up{namespace=\"team-drops\", service=~\"user-service|learning-service|progress-feedback-service|genai-service\"}", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "API Service Availability",
      "type": "state-timeline"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "id": 8,
      "targets": [{"expr": "sum by (service, status) (rate({__name__=~\"http_server_requests_seconds_count|http_requests_total\", namespace=\"team-drops\"}[5m]))", "legendFormat": "{{service}} HTTP {{status}}", "refId": "A"}],
      "title": "HTTP Responses by Status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "id": 9,
      "targets": [
        {"expr": "kube_deployment_spec_replicas{namespace=\"team-drops\", deployment=~\"user-service|learning-service|progress-feedback-service|genai-service\"}", "legendFormat": "{{deployment}} desired", "refId": "A"},
        {"expr": "kube_deployment_status_replicas_available{namespace=\"team-drops\", deployment=~\"user-service|learning-service|progress-feedback-service|genai-service\"}", "legendFormat": "{{deployment}} available", "refId": "B"}
      ],
      "title": "Desired vs Available Replicas",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 31},
      "id": 10,
      "targets": [{"expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"team-drops\", pod=~\"(user-service|learning-service|progress-feedback-service|genai-service)-.+\", container!=\"\", container!=\"POD\"}[15m]))", "legendFormat": "{{pod}} / {{container}}", "refId": "A"}],
      "title": "Container Restarts in 15 Minutes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 31},
      "id": 11,
      "description": "Heap usage for the Java services. The Python GenAI service does not expose JVM metrics.",
      "targets": [{"expr": "100 * sum by (service) (jvm_memory_used_bytes{namespace=\"team-drops\", area=\"heap\"}) / clamp_min(sum by (service) (jvm_memory_max_bytes{namespace=\"team-drops\", area=\"heap\"} > 0), 1)", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "JVM Heap Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"options": {"0": {"color": "red", "text": "NOT READY"}, "1": {"color": "green", "text": "READY"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 7, "w": 16, "x": 0, "y": 39},
      "id": 12,
      "targets": [{"expr": "kube_pod_status_ready{namespace=\"team-drops\", condition=\"true\", pod=~\"(user-service|learning-service|progress-feedback-service|genai-service)-.+\"}", "legendFormat": "{{pod}}", "refId": "A"}],
      "title": "Application Pod Readiness",
      "type": "state-timeline"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 39},
      "id": 13,
      "targets": [{"expr": "scrape_duration_seconds{job=\"team-drops-services\"}", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Prometheus Scrape Duration",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["team-drops", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Team Drops Overview",
  "uid": "team-drops-overview",
  "version": 3
}
