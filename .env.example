# LLM Provider — set to "ollama" for local inference or a cloud provider name (tbd)
LLM_PROVIDER=ollama

# Cloud API key — required when LLM_PROVIDER is a cloud provider
LLM_API_KEY=

# Cloud model name — required when LLM_PROVIDER is a cloud provider
LLM_MODEL=

# Ollama — only used when LLM_PROVIDER=ollama
# Default connects to a natively running Ollama on the host machine.
# When using the ollama Docker Compose profile, change to: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3