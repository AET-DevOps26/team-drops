# LLM Provider — set to "ollama" for local inference or a cloud provider name (tbd)
LLM_PROVIDER=ollama

# Cloud API key — required when LLM_PROVIDER is a cloud provider
LLM_API_KEY=

# Cloud model name — required when LLM_PROVIDER is a cloud provider
LLM_MODEL=

# Ollama — only used when LLM_PROVIDER=ollama
# Docker Compose connects to the Ollama service in the same stack.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Auth / Keycloak
AUTH_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=team-drops
KEYCLOAK_CLIENT_ID=team-drops
